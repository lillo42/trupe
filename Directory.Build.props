<Project>
  <PropertyGroup>
    <TrupeTargetFrameworks>net462;netstandard2.0;net8.0;net9.0;net10.0</TrupeTargetFrameworks>
    <TrupeTestTargetFramework>net10.0</TrupeTestTargetFramework>
    <Nullable>enable</Nullable>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>

    <Authors>Rafael Andrade</Authors>
    <Copyright>Copyright © Rafael Andrade 2026</Copyright>

    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR  '$(TargetFramework)' == 'net462'">
    <LangVersion>12.0</LangVersion>
    <NoWarn>$(NoWarn);nullable</NoWarn>
  </PropertyGroup>
</Project>
